list(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})

include(CMakeFindDependencyMacro)

# detect the OS
if(${CMAKE_SYSTEM_NAME} MATCHES "Windows")
    set(FIND_SFML_OS_WINDOWS 1)
elseif(${CMAKE_SYSTEM_NAME} MATCHES "Linux")
    set(FIND_SFML_OS_LINUX 1)

    if(@SFML_USE_DRM@)
        set(FIND_SFML_USE_DRM 1)
    endif()
elseif(${CMAKE_SYSTEM_NAME} MATCHES "FreeBSD")
    set(FIND_SFML_OS_FREEBSD 1)
elseif(${CMAKE_SYSTEM_NAME} MATCHES "OpenBSD")
    set(FIND_SFML_OS_OPENBSD 1)
elseif(${CMAKE_SYSTEM_NAME} MATCHES "Android")
    set(FIND_SFML_OS_ANDROID 1)
elseif(${CMAKE_SYSTEM_NAME} MATCHES "OHOS")
    set(FIND_SFML_OS_HARMONY 1)
elseif(${CMAKE_SYSTEM_NAME} MATCHES "iOS")
    set(FIND_SFML_OS_IOS 1)
elseif(${CMAKE_SYSTEM_NAME} MATCHES "Darwin")
    set(FIND_SFML_OS_MACOS 1)
endif()

if(FIND_SFML_OS_HARMONY)
    if(NOT DEFINED OHOS_COMPATIBLE_SDK_VERSION OR OHOS_COMPATIBLE_SDK_VERSION STREQUAL "")
        message(FATAL_ERROR
            "This SFML Harmony @SFML_HARMONY_DEVICE_FORM@ package requires "
            "OHOS_COMPATIBLE_SDK_VERSION API level 22 or newer")
    endif()
    if(OHOS_COMPATIBLE_SDK_VERSION MATCHES "\\(([0-9]+)\\)")
        set(_SFML_HARMONY_CONSUMER_API "${CMAKE_MATCH_1}")
    elseif(OHOS_COMPATIBLE_SDK_VERSION MATCHES "^([0-9]+)(\\.|$)")
        set(_SFML_HARMONY_CONSUMER_API "${CMAKE_MATCH_1}")
    else()
        message(FATAL_ERROR
            "Unable to determine the API level from OHOS_COMPATIBLE_SDK_VERSION=${OHOS_COMPATIBLE_SDK_VERSION}")
    endif()
    if(_SFML_HARMONY_CONSUMER_API LESS 22)
        message(FATAL_ERROR
            "This SFML Harmony @SFML_HARMONY_DEVICE_FORM@ package requires "
            "OHOS_COMPATIBLE_SDK_VERSION API level 22 or newer")
    endif()
    unset(_SFML_HARMONY_CONSUMER_API)
endif()

# start with an empty list
set(FIND_SFML_DEPENDENCIES_NOTFOUND)

if(NOT "@BUILD_SHARED_LIBS@")
    if(FIND_SFML_USE_DRM)
        find_dependency(DRM)
        find_dependency(GBM)
    elseif(FIND_SFML_OS_LINUX OR FIND_SFML_OS_FREEBSD OR FIND_SFML_OS_OPENBSD)
        find_dependency(X11 REQUIRED COMPONENTS Xrandr Xcursor)
    endif()

    if(FIND_SFML_OS_LINUX)
        find_dependency(UDev)
    endif()

    if(FIND_SFML_OS_HARMONY)
        find_dependency(EGL)
        if(@SFML_OPENGL_ES@)
            find_dependency(GLES)
        else()
            find_dependency(GLv4)
        endif()
    elseif(@SFML_OPENGL_ES@ AND NOT FIND_SFML_OS_IOS)
        find_dependency(EGL)
        find_dependency(GLES)
    elseif(NOT FIND_SFML_OS_ANDROID AND NOT FIND_SFML_OS_IOS)
        if(NOT OpenGL_GL_PREFERENCE)
            set(OpenGL_GL_PREFERENCE "LEGACY")
        endif()
        find_dependency(OpenGL COMPONENTS OpenGL)
    endif()
elseif(FIND_SFML_OS_HARMONY)
    find_dependency(EGL)
    if(@SFML_OPENGL_ES@)
        find_dependency(GLES)
    else()
        find_dependency(GLv4)
    endif()
elseif(@SFML_OPENGL_ES@ AND NOT FIND_SFML_OS_IOS)
    find_dependency(GLES)
endif()

if(FIND_SFML_DEPENDENCIES_NOTFOUND)
    set(FIND_SFML_ERROR "SFML found but some of its dependencies are missing (${FIND_SFML_DEPENDENCIES_NOTFOUND})")
    set(SFML_FOUND OFF)
endif()
